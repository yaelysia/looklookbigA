{
  "contract_name": "looklookalpha-provider",
  "contract_version": 1,
  "stable_ref": "v1",
  "snapshot": {
    "minimum_schema_version": 15,
    "required_features": {
      "intraday_structure_metrics": "v1",
      "daily_k_context": "v1",
      "live_price_guard": "v1",
      "market_environment": "v1",
      "data_provenance": "v1",
      "changes_since_previous": "v1",
      "company_events": "v1",
      "capital_flow": "v1",
      "fundamentals": "v1"
    },
    "required_top_level_objects": [
      "detail_stocks",
      "groups",
      "indices",
      "live_price_guard",
      "market_environment",
      "data_quality",
      "changes_since_previous",
      "company_events",
      "capital_flow_summary",
      "fundamentals_summary"
    ],
    "required_detail_objects": [
      "quote",
      "intraday",
      "daily_context",
      "events",
      "capital_flow",
      "fundamentals"
    ]
  },
  "workflows": {
    "realtime": ".github/workflows/realtime-quotes.yml",
    "reusable": ".github/workflows/reusable-a-share-quotes.yml",
    "engine_revision_binding": "EXACT_40_HEX_SHA_OR_CALLED_WORKFLOW_SHA"
  },
  "refresh_operation": {
    "contract_version": 1,
    "identity_fields": [
      "dispatch_correlation_id",
      "idempotency_key",
      "command_digest",
      "workflow_identity",
      "material_execution_inputs"
    ],
    "terminal_states": [
      "SUCCEEDED",
      "FAILED",
      "CANCELLED"
    ],
    "states": [
      "ACCEPTED",
      "QUEUED",
      "RUNNING",
      "SUCCEEDED",
      "FAILED",
      "CANCELLED"
    ],
    "latest_run_fallback_allowed": false,
    "same_key_same_digest": "RECOVER_SAME_OPERATION",
    "same_key_different_digest": "CONFLICT",
    "same_correlation_different_digest": "CORRELATION_MISMATCH"
  },
  "primary_artifact": {
    "name": "realtime-snapshot",
    "snapshot_path": "snapshot.json",
    "manifest_path": "alpha-artifact-manifest.json",
    "cardinality": "EXACTLY_ONE",
    "digest_algorithm": "SHA-256",
    "digest_source": "PROVIDER_COMPUTED_OR_CONSUMER_VERIFIED"
  }
}
